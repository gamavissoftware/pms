sfpo/
shubhamquotation/
designform/
tmp/
application/cache/
application/logs/
!application/cache/index.html
!application/logs/index.html

# ── Loose documents & images in the project ROOT only ────────────────
# Root-scoped with a leading slash so assets/ is unaffected.
# /*png (no dot) catches the extensionless junk: 1658566548png etc.
/*png
/*.pdf
/*.png
/*.jpg
/*.jpeg
/*.xls
/*.xlsx
/*.csv

# ── Framework core — absent from the tree; never commit if restored ──
/system/

# ── OS / editor ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# ── Pre-push backup copies & build output ────────────────────────────
*.bak-*
.presentation-build/

# ── AI key config (real key lives only on the server) ────────────────
application/config/chat_ai.php
